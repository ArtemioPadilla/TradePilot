---
/**
 * DESTINATION: web/src/pages/tools.astro
 *
 * /tools — PUBLIC calculators page (no AuthGuard). Shell only; the three
 * calculators (compound growth — ported from the old app — plus new
 * Sharpe/Sortino and drawdown calculators built on the engine functions)
 * live in the CalculatorsPage island.
 */
import { withBase } from '@/lib/href';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CalculatorsPage from '@/components/islands/CalculatorsPage';
---

<BaseLayout
  title="Financial tools & calculators | TradePilot"
  description="Free in-browser calculators: compound-growth projections with monthly contributions, Sharpe and Sortino ratios from your own return series, and drawdown analysis of any equity curve."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">Tools</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-foreground">
        Financial calculators
      </h1>
      <p class="mt-2 max-w-2xl text-muted-foreground">
        Everything runs in your browser — nothing you paste here leaves the page. The Sharpe and
        drawdown calculators use the exact engine functions that score TradePilot backtests.
      </p>
    </header>

    <CalculatorsPage client:load />

    <p class="mt-10 text-sm text-muted-foreground">
      New to these numbers? The
      <a href={withBase('/learn/')} class="font-medium text-primary underline underline-offset-2 hover:text-primary/80">Learn page</a>
      explains every metric with worked examples.
    </p>
  </main>
</BaseLayout>
