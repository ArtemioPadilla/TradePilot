---
import BaseLayout from '../layouts/BaseLayout.astro';
import RunViewPage from '../components/islands/RunViewPage';
---

<BaseLayout
  title="Shared run"
  description="A shared TradePilot backtest run: configuration, metrics, and equity curve."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Backtest run</h1>
    </header>
    <RunViewPage client:load />
  </main>
</BaseLayout>
