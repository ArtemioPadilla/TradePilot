---
/**
 * DESTINATION: web/src/pages/catalog.astro
 *
 * /catalog — PUBLIC interactive strategy catalog (no AuthGuard). Shell only;
 * the StrategyCatalogPage island holds the built-in strategy cards (content
 * ported from the old app's StrategyCatalog) with live ranking demos that
 * call the real engine strategy functions, plus the 5 AI templates.
 */
import { withBase } from '@/lib/href';
import BaseLayout from '@/layouts/BaseLayout.astro';
import StrategyCatalogPage from '@/components/islands/StrategyCatalogPage';
---

<BaseLayout
  title="Strategy catalog — momentum, mean reversion, smart beta | TradePilot"
  description="Interactive catalog of TradePilot's built-in trading strategies. Formulas, parameters, pros and cons — and live ranking demos running the real engine on sample data, plus five AI strategy templates."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">Catalog</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-foreground">
        Strategy catalog
      </h1>
      <p class="mt-2 max-w-2xl text-muted-foreground">
        Every ranking rule the engine ships with, explained and runnable. The demos execute the
        same functions your backtests use — on a deterministic sample universe, right in your
        browser.
      </p>
    </header>

    <StrategyCatalogPage client:load />

    <p class="mt-10 text-sm text-muted-foreground">
      Unsure which family fits which market?
      <a href={withBase('/learn/')} class="font-medium text-primary underline underline-offset-2 hover:text-primary/80">Start with the Learn page</a>.
    </p>
  </main>
</BaseLayout>
