---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthForms from '../../components/islands/AuthForms';
---

<BaseLayout
  title="Sign in"
  description="Sign in to TradePilot to save strategies, run backtests, and publish results."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <header class="mb-10 text-center">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">
        Welcome to TradePilot
      </h1>
      <p class="mt-2 text-muted-foreground">
        Sign in or create an account to save strategies and backtests.
      </p>
    </header>

    <AuthForms client:load />
  </main>
</BaseLayout>
