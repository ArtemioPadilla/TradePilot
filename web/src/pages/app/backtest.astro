---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BacktestRunPage from '../../components/islands/BacktestRunPage';
---

<BaseLayout
  title="Backtest"
  description="Run a real backtest in your browser: pick a universe, strategy, and optimizer — the engine does the rest."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Backtest</h1>
      <p class="mt-2 text-muted-foreground">
        Runs entirely in your browser — market data via Yahoo Finance, simulation in a web worker.
      </p>
    </header>
    <BacktestRunPage client:load />
  </main>
</BaseLayout>
