---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StrategiesPage from '../../components/islands/StrategiesPage';
---

<BaseLayout
  title="Strategies"
  description="Create and manage your trading strategies: momentum, mean reversion, smart beta, or custom code."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Strategies</h1>
      <p class="mt-2 text-muted-foreground">
        Ranking rules the backtester uses to pick assets. Draft custom ones with the builder.
      </p>
    </header>
    <StrategiesPage client:load />
  </main>
</BaseLayout>
