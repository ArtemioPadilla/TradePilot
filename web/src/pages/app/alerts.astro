---
// DESTINATION: web/src/pages/app/alerts.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlertsPage from '../../components/islands/AlertsPage';
---

<BaseLayout
  title="Alerts"
  description="Price alerts you can check on demand: above/below thresholds per symbol."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Alerts</h1>
      <p class="mt-2 text-muted-foreground">
        Price thresholds per symbol. Checks run in your browser on demand — no background
        monitoring on this static deployment.
      </p>
    </header>
    <AlertsPage client:load />
  </main>
</BaseLayout>
