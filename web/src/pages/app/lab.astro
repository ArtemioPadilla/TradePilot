---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabPage from '../../components/islands/LabPage';
---

<BaseLayout
  title="Backtest Lab"
  description="Compare strategies side by side, sweep parameter grids with heatmaps, and stress-test with walk-forward analysis."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Backtest Lab</h1>
      <p class="mt-2 text-muted-foreground">
        Compare, sweep, and walk-forward — every run computed in parallel web workers, in your browser.
      </p>
    </header>
    <LabPage client:load />
  </main>
</BaseLayout>
