---
// DESTINATION: web/src/pages/app/accounts.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountsPage from '../../components/islands/AccountsPage';
---

<BaseLayout
  title="Accounts"
  description="Manage investment accounts, holdings with live prices and P/L, and your transaction history."
  lang="en"
>
  <main id="main-content" class="mx-auto max-w-5xl px-4 py-12">
    <header class="mb-8">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Accounts</h1>
      <p class="mt-2 text-muted-foreground">
        Accounts, holdings with live market values, and your transaction history.
      </p>
    </header>
    <AccountsPage client:load />
  </main>
</BaseLayout>
